# =================================================================
# Stream Extractor API - Environment Configuration Template
# =================================================================

# Server Port & Host (Default: 5000, 0.0.0.0)
# Automatically detected and populated by PaaS providers (e.g. Render, Railway, Heroku) via $PORT
PORT=5000
HOST=0.0.0.0
DEBUG=false

# Public Base URL (Used for generating absolute download and stream proxy URLs)
BASE_URL=http://localhost:5000

# YouTube Cookies (Optional for Render / Containerized environments)
# Paste the full raw Netscape HTTP cookie format text here if deploying to
# platforms where you cannot mount a physical cookies.txt file.
YTDLP_COOKIES=

# Spotify API Configuration (Optional)
# The extractor operates 100% KEYLESS by default via embed metadata extraction.
# If you wish to use official Spotify Developer API credentials, configure below:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_BASE=https://api2.spotify.pgwiz.uk

# =================================================================
# Telegram Bot Worker Configuration (Optional)
# =================================================================
# If running via `python -m bot.main` on platforms like Render:
# Providing TELEGRAM_TOKEN automatically boots the interactive Telegram bot.
# In Render Web Service mode: both the Uvicorn web server ($PORT) and
# the Telegram bot run concurrently in a single process.
# In Render Background Worker mode: only the bot worker loop runs.
TELEGRAM_TOKEN=
